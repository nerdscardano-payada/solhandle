        "PAYOUT",
        "ADJUSTMENT",
        "REVERSAL",
        "BONUS"
      ]
    },
    "amount_lamports": {
      "type": "number"
    },
    "conversion_id": {
      "type": "string"
    },
    "payout_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "AVAILABLE",
        "PAID",
        "REVERSED"
      ]
    }
  },
  "required": [
    "referral_profile_id",
    "type",
    "amount_lamports",
    "status"
  ],
  "rls": {
