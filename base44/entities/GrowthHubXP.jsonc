{
  "name": "GrowthHubXP",
  "type": "object",
  "properties": {
    "completion_key": {
      "type": "string"
    },
    "wallet": {
      "type": "string"
    },
    "quest_id": {
      "type": "string"
    },
    "quest_slug": {
      "type": "string"
    },
    "quest_title": {
      "type": "string"
    },
    "quest_version": {
      "type": "integer"
    },
    "season_id": {
      "type": "string"
    },
    "delta": {
      "type": "integer"
    },
    "reward_eligible_delta": {
      "type": "integer",
      "default": 0
    },
    "source_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "credited_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "PILOT"
      ]
    }
  },
  "required": [
    "completion_key",
    "wallet",
    "quest_id",
    "quest_slug",
    "quest_title",
    "quest_version",
    "delta",
    "source_id",
    "credited_at",
    "mode"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}