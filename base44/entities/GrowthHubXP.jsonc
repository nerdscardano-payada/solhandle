{
  "name": "GrowthHubXP",
  "type": "object",
  "properties": {
    "completion_key": {
      "type": "string"
    },
    "wallet": {
      "type": "string"
    },
    "quest_id": {
      "type": "string"
    },
    "quest_slug": {
      "type": "string"
    },
    "quest_title": {
      "type": "string"
    },
    "quest_version": {
      "type": "integer"
    },
    "season_id": {
      "type": "string"
    },
    "delta": {
      "type": "integer"
    },
    "reward_eligible_delta": {
      "type": "integer",
      "default": 0
    },
    "source_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "credited_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "PILOT"
      ]
    },
    "chain_evidence": {
      "type": "object",
      "properties": {
        "signature": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "slot": {
          "type": "integer"
        },
        "occurred_at": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "asset_address": {
          "type": "string"
        },
        "collection": {
          "type": "string"
        },
        "original_minter": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "amount_lamports": {
          "type": "integer"
        },
        "token_mint": {
          "type": "string"
        },
        "amount_raw": {
          "type": "string"
        },
        "burned_raw": {
          "type": "string"
        },
        "treasury_raw": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "completion_key",
    "wallet",
    "quest_id",
    "quest_slug",
    "quest_title",
    "quest_version",
    "delta",
    "source_id",
    "credited_at",
    "mode"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}