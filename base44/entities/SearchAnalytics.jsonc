{
  "name": "SearchAnalytics",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string"
    },
    "available_at_search": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "CLAIMED",
        "RESERVED",
        "PROTECTED",
        "UNAVAILABLE"
      ]
    },
    "session_hash": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "event_key": {
      "type": "string"
    }
  },
  "required": [
    "handle",
    "available_at_search"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}