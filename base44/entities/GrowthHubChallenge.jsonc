{
  "name": "GrowthHubChallenge",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "string"
    },
    "nonce": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "wallet",
    "nonce",
    "message",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}