{
  "name": "NetworkProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "PROJECT",
        "BUILDER",
        "PERSON"
      ],
      "default": "PROJECT"
    },
    "category": {
      "type": "string",
      "enum": [
        "WALLET",
        "DEFI",
        "NFT",
        "INFRASTRUCTURE",
        "GAMING",
        "COMMUNITY",
        "OTHER"
      ]
    },
    "expertise": {
      "type": "string",
      "maxLength": 120
    },
    "website": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https://[^\\s]+$"
    },
    "social_links": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 500,
        "pattern": "^https://[^\\s]+$"
      }
    },
    "handle": {
      "type": "string",
      "maxLength": 21,
      "pattern": "^$|^@[a-z0-9]{1,20}$"
    },
    "pfp_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://[^\\s]+$"
    },
    "banner_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://[^\\s]+$"
    },
    "product_status": {
      "type": "string",
      "enum": [
        "BUILDING",
        "LIVE",
        "PAUSED"
      ],
      "default": "LIVE"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "source_reference": {
      "type": "string",
      "maxLength": 40
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "HIDDEN"
      ],
      "default": "DRAFT"
    },
    "integration_valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "integration_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "integration_evidence_url": {
      "type": "string",
      "maxLength": 500
    },
    "integration_reviewed_website": {
      "type": "string",
      "maxLength": 500
    },
    "handle_valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "handle_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "handle_evidence_url": {
      "type": "string",
      "maxLength": 500
    },
    "handle_owner_wallet": {
      "type": "string",
      "maxLength": 44
    },
    "handle_verified_asset": {
      "type": "string",
      "maxLength": 44
    },
    "handle_reviewed_handle": {
      "type": "string",
      "maxLength": 21
    },
    "handle_reviewed_website": {
      "type": "string",
      "maxLength": 500
    },
    "handle_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "handle_check_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "handle_check_interval_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    },
    "handle_check_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "UNCERTAIN",
        "INACTIVE"
      ]
    }
  },
  "required": [
    "name",
    "summary",
    "category",
    "website",
    "status",
    "pfp_url",
    "banner_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "PUBLISHED"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}