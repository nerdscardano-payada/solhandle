{
  "name": "TokenMintPayment",
  "type": "object",
  "properties": {
    "signature": {
      "type": "string"
    },
    "handle": {
      "type": "string"
    },
    "asset_address": {
      "type": "string"
    },
    "wallet": {
      "type": "string"
    },
    "token_mint": {
      "type": "string"
    },
    "decimals": {
      "type": "integer"
    },
    "amount_raw": {
      "type": "string"
    },
    "burned_raw": {
      "type": "string"
    },
    "treasury_raw": {
      "type": "string"
    },
    "total_tokens": {
      "type": "number"
    },
    "burned_tokens": {
      "type": "number"
    },
    "treasury_tokens": {
      "type": "number"
    },
    "sol_reference_lamports": {
      "type": "number"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "signature",
    "handle",
    "asset_address",
    "wallet",
    "token_mint",
    "decimals",
    "amount_raw",
    "burned_raw",
    "treasury_raw",
    "sol_reference_lamports",
    "confirmed_at"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}