{
  "name": "IntegrationAbuse",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "PEPPER",
        "ATTEMPT"
      ]
    },
    "bucket": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "kind",
    "bucket",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}