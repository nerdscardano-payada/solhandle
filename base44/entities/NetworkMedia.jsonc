{
  "name": "NetworkMedia",
  "type": "object",
  "properties": {
    "owner_public_id": {
      "type": "string"
    },
    "file_uri": {
      "type": "string",
      "maxLength": 2048
    },
    "mime_type": {
      "type": "string",
      "enum": [
        "image/jpeg",
        "image/png",
        "image/webp"
      ]
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "TEST"
      ]
    }
  },
  "required": [
    "owner_public_id",
    "file_uri",
    "mime_type",
    "byte_size",
    "width",
    "height",
    "status",
    "environment"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}