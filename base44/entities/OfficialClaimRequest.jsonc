{
  "name": "OfficialClaimRequest",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "proof_url": {
      "type": "string"
    },
    "recipient_wallet": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "reserved_for": {
      "type": "string"
    },
    "official_domain": {
      "type": "string"
    },
    "challenge": {
      "type": "string"
    },
    "challenge_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "domain_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "wallet_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "wallet_signature": {
      "type": "string"
    },
    "high_risk": {
      "type": "boolean"
    },
    "manual_channel_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "domain_verified",
        "verified",
        "rejected",
        "minted"
      ]
    },
    "mint_signature": {
      "type": "string"
    },
    "asset_address": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "handle",
    "organization",
    "contact_name",
    "contact_email",
    "proof_url",
    "recipient_wallet",
    "statement",
    "official_domain",
    "challenge",
    "challenge_expires_at",
    "high_risk",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}