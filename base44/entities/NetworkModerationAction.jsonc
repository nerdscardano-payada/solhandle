{
  "name": "NetworkModerationAction",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string"
    },
    "post_id": {
      "type": "string"
    },
    "moderator_user_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "HIDE",
        "DISMISS",
        "RESTORE"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "environment": {
      "type": "string",
      "enum": [
        "TEST"
      ]
    }
  },
  "required": [
    "report_id",
    "post_id",
    "moderator_user_id",
    "action",
    "reason",
    "environment"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}