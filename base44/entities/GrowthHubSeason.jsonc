{
  "name": "GrowthHubSeason",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ACTIVE",
        "PAUSED",
        "ENDED"
      ]
    },
    "starts_at": {
      "type": "string"
    },
    "ends_at": {
      "type": "string"
    },
    "duration_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "proposed_budget_tokens": {
      "type": "string"
    },
    "rules_version": {
      "type": "integer",
      "minimum": 1
    },
    "payouts_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "slug",
    "name",
    "status",
    "duration_days",
    "proposed_budget_tokens",
    "rules_version"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}