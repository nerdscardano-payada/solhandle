{
  "name": "LoungeModerationLog",
  "type": "object",
  "properties": {
    "admin_wallet": {
      "type": "string"
    },
    "target_wallet": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "delete",
        "mute",
        "unmute",
        "ban",
        "unban"
      ]
    },
    "reason": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    }
  },
  "required": [
    "admin_wallet",
    "target_wallet",
    "action",
    "reason"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}