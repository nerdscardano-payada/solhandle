{
  "name": "ReferralProfile",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    },
    "display_handle": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PAUSED",
        "SUSPENDED",
        "BANNED"
      ]
    },
    "show_on_leaderboard": {
      "type": "boolean",
      "default": true
    },
    "successful_referrals": {
      "type": "number",
      "default": 0
    },
    "total_earnings_lamports": {
      "type": "number",
      "default": 0
    },
    "pending_earnings_lamports": {
      "type": "number",
      "default": 0
    },
    "paid_earnings_lamports": {
      "type": "number",
      "default": 0
    },
    "token_balance_cached": {
      "type": "number",
      "default": 0
    },
    "earning_tier_percentage": {
      "type": "number",
      "default": 0
    },
    "pending_tier_percentage": {
      "type": "number",
      "default": 0
    },
    "tier_qualified_at": {
      "type": "string",
      "format": "date-time"
    },
    "tier_activates_at": {
      "type": "string",
      "format": "date-time"
    },
    "tier_checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "wallet_address",
    "referral_code",
    "display_handle",
    "status",
    "successful_referrals",
    "total_earnings_lamports",
    "pending_earnings_lamports",
    "paid_earnings_lamports"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}