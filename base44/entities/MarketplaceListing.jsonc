{
  "name": "MarketplaceListing",
  "type": "object",
  "properties": {
    "asset_address": {
      "type": "string"
    },
    "handle": {
      "type": "string"
    },
    "marketplace": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "listing_url": {
      "type": "string"
    },
    "seller": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE"
      ]
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "asset_address",
    "marketplace",
    "price",
    "currency",
    "listing_url",
    "status",
    "last_verified_at"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}