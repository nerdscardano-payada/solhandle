{
  "name": "PageView",
  "type": "object",
  "properties": {
    "route": {
      "type": "string"
    },
    "referrer": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "wallet_connected": {
      "type": "boolean"
    },
    "referral_code": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "route",
    "session_id",
    "wallet_connected",
    "timestamp"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}