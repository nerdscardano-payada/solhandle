{
  "name": "NetworkWalletChallenge",
  "type": "object",
  "properties": {
    "account_public_id": {
      "type": "string"
    },
    "operator_user_id": {
      "type": "string"
    },
    "wallet": {
      "type": "string"
    },
    "handle": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "maxLength": 2048
    },
    "purpose": {
      "type": "string",
      "enum": [
        "DEVELOPMENT_BIND_HANDLE",
        "DEVELOPMENT_SAVE_PROFILE"
      ]
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "origin": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "ISSUED",
        "USED"
      ]
    }
  },
  "required": [
    "account_public_id",
    "operator_user_id",
    "wallet",
    "handle",
    "message",
    "purpose",
    "origin",
    "expires_at",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}