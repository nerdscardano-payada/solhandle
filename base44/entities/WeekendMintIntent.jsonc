{
  "name": "WeekendMintIntent",
  "type": "object",
  "properties": {
    "campaign": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "recipient": {
      "type": "string"
    },
    "tokens": {
      "type": "number"
    },
    "wallet": {
      "type": "string"
    },
    "admin_id": {
      "type": "string"
    },
    "unsigned": {
      "type": "string"
    },
    "last_valid_height": {
      "type": "number"
    },
    "signature": {
      "type": "string"
    },
    "lock_token": {
      "type": "string"
    },
    "lease_until": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "preparing",
        "prepared",
        "submitted",
        "confirmed",
        "expired",
        "failed"
      ]
    }
  },
  "required": [
    "campaign",
    "key",
    "kind",
    "recipient",
    "tokens"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}