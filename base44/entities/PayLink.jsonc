{
  "name": "PayLink",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string"
    },
    "recipient_wallet_at_creation": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_amount_sol": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "REUSABLE",
        "SINGLE_USE"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "expires_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "PROCESSING",
        "PAID",
        "CANCELLED",
        "EXPIRED",
        "INVALID"
      ]
    },
    "cancelled_at": {
      "type": "string"
    },
    "paid_at": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "processing_signature": {
      "type": "string"
    },
    "processing_sender": {
      "type": "string"
    },
    "processing_amount_lamports": {
      "type": "number"
    },
    "processing_blockhash": {
      "type": "string"
    }
  },
  "required": [
    "handle",
    "recipient_wallet_at_creation",
    "created_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}