{
  "name": "DiscordVerification",
  "type": "object",
  "properties": {
    "token_hash": {
      "type": "string"
    },
    "discord_user_id": {
      "type": "string"
    },
    "discord_username": {
      "type": "string"
    },
    "guild_id": {
      "type": "string"
    },
    "wallet_address": {
      "type": "string"
    },
    "verified_handle": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "VERIFIED",
        "EXPIRED",
        "FAILED"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token_hash",
    "discord_user_id",
    "guild_id",
    "status",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}