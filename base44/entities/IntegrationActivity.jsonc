{
  "name": "IntegrationActivity",
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string"
    },
    "submission_type": {
      "type": "string",
      "enum": [
        "project",
        "nomination"
      ]
    },
    "action_type": {
      "type": "string"
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "actor_id": {
      "type": "string"
    }
  },
  "required": [
    "submission_id",
    "submission_type",
    "action_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}