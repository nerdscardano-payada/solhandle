{
  "name": "FunnelEvent",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "step": {
      "type": "string",
      "enum": [
        "SEARCH",
        "CLAIM_CLICK",
        "WALLET_CONNECTED",
        "MINT_STARTED",
        "MINT_CONFIRMED"
      ]
    },
    "handle": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "session_id",
    "step",
    "timestamp"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}