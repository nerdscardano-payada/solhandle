{
  "name": "NetworkProfile",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "public_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "maxLength": 80
    },
    "bio": {
      "type": "string",
      "maxLength": 500
    },
    "kind": {
      "type": "string",
      "enum": [
        "PERSON",
        "CREATOR",
        "PROJECT"
      ]
    },
    "social_links": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "HIDDEN"
      ]
    },
    "preview": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "account_id",
    "public_id",
    "display_name",
    "kind",
    "status",
    "preview"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}