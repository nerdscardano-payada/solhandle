{
  "name": "Payment",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string"
    },
    "receiver_wallet": {
      "type": "string"
    },
    "sender_wallet": {
      "type": "string"
    },
    "sender_primary_handle": {
      "type": "string"
    },
    "amount_lamports": {
      "type": "number"
    },
    "asset": {
      "type": "string",
      "enum": [
        "SOL",
        "USDC",
        "USDT",
        "HANDLE"
      ]
    },
    "amount_raw": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "token_mint": {
      "type": "string"
    },
    "token_decimals": {
      "type": "integer"
    },
    "tx_signature": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "FAILED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "request_description": {
      "type": "string"
    }
  },
  "required": [
    "handle",
    "receiver_wallet",
    "sender_wallet",
    "tx_signature",
    "status",
    "created_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}