{
  "name": "ReferralSettings",
  "type": "object",
  "properties": {
    "referral_enabled": {
      "type": "boolean",
      "default": false
    },
    "campaign_enabled": {
      "type": "boolean",
      "default": true
    },
    "campaign_name": {
      "type": "string",
      "default": "SolHandle Earn Network"
    },
    "commission_percentage": {
      "type": "number",
      "default": 20
    },
    "campaign_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "campaign_end_date": {
      "type": "string",
      "format": "date-time"
    },
    "cookie_duration_days": {
      "type": "number",
      "default": 30
    },
    "minimum_payout_sol": {
      "type": "number",
      "default": 0.1
    },
    "auto_payout_enabled": {
      "type": "boolean",
      "default": false
    },
    "payouts_paused": {
      "type": "boolean",
      "default": true
    },
    "payout_wallet_address": {
      "type": "string",
      "default": ""
    },
    "payout_hold_hours": {
      "type": "number",
      "default": 24
    },
    "premium_referral_eligible": {
      "type": "boolean",
      "default": true
    },
    "tier_1_percentage": {
      "type": "number",
      "default": 10
    },
    "tier_2_percentage": {
      "type": "number",
      "default": 12.5
    },
    "tier_3_percentage": {
      "type": "number",
      "default": 15
    },
    "tier_4_percentage": {
      "type": "number",
      "default": 20
    },
    "tier_2_start": {
      "type": "number",
      "default": 10
    },
    "tier_3_start": {
      "type": "number",
      "default": 50
    },
    "tier_4_start": {
      "type": "number",
      "default": 100
    },
    "earn_network_mode": {
      "type": "string",
      "enum": [
        "PRELAUNCH",
        "LIVE",
        "PAUSED"
      ],
      "default": "PRELAUNCH"
    },
    "token_mint_address": {
      "type": "string",
      "default": ""
    },
    "tier_qualification_hours": {
      "type": "number",
      "default": 24
    },
    "token_tier_1_minimum": {
      "type": "number",
      "default": 25000
    },
    "token_tier_2_minimum": {
      "type": "number",
      "default": 100000
    },
    "token_tier_3_minimum": {
      "type": "number",
      "default": 250000
    },
    "token_tier_4_minimum": {
      "type": "number",
      "default": 1000000
    },
    "token_tier_1_percentage": {
      "type": "number",
      "default": 20
    },
    "token_tier_2_percentage": {
      "type": "number",
      "default": 30
    },
    "token_tier_3_percentage": {
      "type": "number",
      "default": 40
    },
    "token_tier_4_percentage": {
      "type": "number",
      "default": 50
    },
    "secondary_referrer_share_percentage": {
      "type": "number",
      "default": 50
    },
    "creator_fee_referrer_share_percentage": {
      "type": "number",
      "default": 50
    },
    "creator_fee_referrer_cap_percentage": {
      "type": "number",
      "default": 30
    },
    "creator_fee_carry_lamports": {
      "type": "number",
      "default": 0
    },
    "creator_fee_cycle_token_mints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "referral_enabled",
    "cookie_duration_days",
    "minimum_payout_sol",
    "auto_payout_enabled",
    "payouts_paused",
    "payout_wallet_address",
    "payout_hold_hours",
    "premium_referral_eligible",
    "tier_1_percentage",
    "tier_2_percentage",
    "tier_3_percentage",
    "tier_4_percentage",
    "tier_2_start",
    "tier_3_start",
    "tier_4_start"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}