        "released"
      ]
    },
    "restriction_type": {
      "type": "string",
      "enum": [
        "PROTECTED",
        "RESERVED"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "STANDARD"
      ]
    },
    "public_mint": {
      "type": "boolean"
    },
    "official_claim_allowed": {
      "type": "boolean"
    },
