{
  "name": "NetworkPost",
  "type": "object",
  "properties": {
    "author_public_id": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "maxLength": 2000
    },
    "parent_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "HIDDEN",
        "DELETED"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "preview": {
      "type": "boolean",
      "default": true
    },
    "discovery_score": {
      "type": "number",
      "default": 0
    },
    "media_ids": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "author_snapshot": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "maxLength": 80
        },
        "handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "binding_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "mentions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "account_id",
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "author_public_id",
    "body",
    "status",
    "preview"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}