{
  "name": "TokenPassportChallenge",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "wallet": {
      "type": "string"
    },
    "payload_hash": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "issued",
        "used"
      ],
      "enumColors": [
        "yellow",
        "green"
      ]
    }
  },
  "required": [
    "key",
    "wallet",
    "payload_hash",
    "message",
    "expires_at",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}