        "SUBMITTED",
        "CONFIRMED",
        "FINALIZED",
        "FAILED",
        "EXPIRED"
      ]
    },
    "signature": {
      "type": "string"
    },
    "desired_state": {
      "type": "object",
      "additionalProperties": true
    }
