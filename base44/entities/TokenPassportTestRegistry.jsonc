{
  "name": "TokenPassportTestRegistry",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "ADMIN_TEST"
      ],
      "enumColors": [
        "purple"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "challenges": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "history": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "production_migrated": {
      "type": "boolean",
      "default": false
    },
    "production_migrated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "scope",
    "version",
    "items",
    "challenges",
    "history"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}