{
  "name": "TokenPassportEnrollment",
  "type": "object",
  "properties": {
    "pilot_id": {
      "type": "string"
    },
    "wallet": {
      "type": "string"
    },
    "handle": {
      "type": "string"
    },
    "mint": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "open",
        "invited"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "maker_type": {
      "type": "string",
      "enum": [
        "existing",
        "new"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "started",
        "completed",
        "withdrawn",
        "ineligible"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green",
        "gray",
        "red"
      ]
    },
    "eligible": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "passport_key": {
      "type": "string"
    }
  },
  "required": [
    "pilot_id",
    "wallet",
    "handle",
    "mint",
    "source",
    "maker_type",
    "status",
    "eligible"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}