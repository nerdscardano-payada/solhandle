{
  "name": "NetworkAccount",
  "type": "object",
  "properties": {
    "public_id": {
      "type": "string"
    },
    "operator_user_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "OPERATOR_PREVIEW",
        "MEMBER",
        "DEVELOPMENT"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "DELETED"
      ]
    }
  },
  "required": [
    "public_id",
    "mode",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}