{
  "name": "HandlePublicProfile",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "string"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9]{1,20}$"
    },
    "asset": {
      "type": "string"
    },
    "bio": {
      "type": "string",
      "maxLength": 500
    },
    "social_links": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "avatar": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "file_uri": {
          "type": "string",
          "maxLength": 2048
        },
        "key": {
          "type": "string",
          "maxLength": 44
        },
        "iv": {
          "type": "string",
          "maxLength": 16
        }
      },
      "required": [
        "file_uri",
        "key",
        "iv"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "wallet",
    "handle",
    "asset",
    "bio",
    "social_links",
    "published"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}