{
  "name": "HandlePublicProfile",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "string"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9]{1,20}$"
    },
    "asset": {
      "type": "string"
    },
    "bio": {
      "type": "string",
      "maxLength": 500
    },
    "social_links": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "wallet",
    "handle",
    "asset",
    "bio",
    "social_links",
    "published"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}