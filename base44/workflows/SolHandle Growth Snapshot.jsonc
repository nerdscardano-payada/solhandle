{
  "name": "SolHandle Growth Snapshot",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Brussels",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "solhandle_growth_snapshot",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_growth": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "growthCurve",
            "args": {
              "action": "refresh"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Ververs groeimetingen",
            "description": "Mints en tokenhouders"
          }
        }
      }
    ]
  },
  "description": "Meet elk uur bevestigde SolHandle-mints en houders die 24 uur gekwalificeerd blijven."
}