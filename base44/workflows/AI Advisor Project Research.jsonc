{
  "description": "Validates public anti-spam submissions and prepares private, source-linked SolHandle integration reports. No repository writes or test execution.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "AIAnalysisRequest"
    }
  },
  "name": "AI Advisor Project Research",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_advisor_project_research",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "research_project": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "aiAdvisorResearch",
            "args": {
              "request_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Project onderzoeken",
            "description": "Controleert anti-spam en maakt een priv\u00e9rapport"
          }
        }
      }
    ]
  }
}