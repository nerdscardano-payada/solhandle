{
  "description": "Synchronise confirmed SolHandle mints from Devnet into the index.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "solhandle_index_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_index": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncSolHandleIndex",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Synchroniseer SolHandle-index",
            "description": "Bevestigde Devnet-mints"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "SolHandle Index Sync"
}