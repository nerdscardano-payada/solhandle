  "description": "Controleert uitsluitend goedgekeurde handlekoppelingen wanneer hun expliciet gekozen controletermijn is verstreken. Een overdracht verwijdert alleen het handle-rankingvoordeel.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "discover_handle_ranking_checks",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_due_handles": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "discoverRanking",
            "args": {
              "action": "maintenance"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Controleer verschuldigde handlekoppelingen",
            "description": "Alleen het rankingvoordeel aanpassen"
          }
        }
      }
    ]
  },
  "name": "Discover Handle Ranking Checks"
