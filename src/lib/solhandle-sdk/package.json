{
  "name": "solhandle-sdk",
  "version": "1.0.0",
  "description": "Official Mainnet Beta SDK for resolving and verifying SolHandle identities on Solana.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "errors.js",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@solana/web3.js": ">=1.95.0 <2"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.4"
  },
  "license": "UNLICENSED"
}